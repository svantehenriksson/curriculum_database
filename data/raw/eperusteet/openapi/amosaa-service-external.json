ags":["external"]}},"/api/external/opetussuunnitelmat":{"get":{"operationId":"getPublicOpetussuunnitelmat","parameters":[{"description":"Perusteen diaarinumero.","in":"query","name":"perusteenDiaarinumero","schema":{"items":{"type":"string"},"type":"array"}},{"description":"Perusteen tunnisteet ePerusteet-palvelussa (perusteId).","in":"query","name":"perusteId","schema":{"items":{"format":"int64","type":"integer"},"type":"array"}},{"description":"Koulutustoimijan organisaatiotunnisteet (OID).","in":"query","name":"organisaatio","schema":{"items":{"type":"string"},"type":"array"}},{"description":"Opetussuunnitelman tyyppi (esim. ops, yhteinen, yleinen). Oletusarvo 'ops', jos parametria ei anneta.","in":"query","name":"tyyppi","schema":{"items":{"type":"string"},"type":"array"}},{"description":"Sivutus: haettavan sivun numero (0-indeksoitu). Oletusarvo 0.","in":"query","name":"sivu","schema":{"format":"int64","type":"integer"}},{"description":"Sivutus: yhdellä sivulla palautettavien tulosten määrä. Oletusarvo 10. Maksimi 50.","in":"query","name":"sivukoko","schema":{"format":"int64","type":"integer"}},{"description":"Vapaa tekstihaku opetussuunnitelman ja koulutustoimijan nimeen (osittainen täsmäys, kieli-parametrin mukaisella kielellä).","in":"query","name":"nimi","schema":{"type":"string"}},{"description":"Kieli, jolla nimeä haetaan ja jolla tulokset järjestetään. Suodattaa myös julkaistuja kieliversioita. Oletusarvo fi.","in":"query","name":"kieli","schema":{"type":"string"}},{"description":"Oppilaitostyypin koodisto-URI (koulutustoimijan oppilaitosTyyppiKoodiUri). Tyhjä arvo ei rajaa tuloksia.","in":"query","name":"oppilaitosTyyppiKoodiUri","schema":{"type":"string"}},{"description":"Koulutustyypit (esim. koulutustyyppi_1). Useita arvoja voi antaa toistamalla parametrin. Tyhjä lista ei rajaa tuloksia.","in":"query","name":"koulutustyyppi","schema":{"items":{"type":"string"},"type":"array"}},{"description":"Sisällytetäänkö tulevaisuudessa voimaan tulevat opetussuunnitelmat (voimaantulo > nykyhetki). Oletusarvo true.","in":"query","name":"tuleva","schema":{"type":"boolean"}},{"description":"Sisällytetäänkö voimassa olevat opetussuunnitelmat. Oletusarvo true.","in":"query","name":"voimassaolo","schema":{"type":"boolean"}},{"description":"Sisällytetäänkö voimassaolon päättyneet opetussuunnitelmat. Oletusarvo true.","in":"query","name":"poistunut","schema":{"type":"boolean"}},{"description":"JOTPA-tyypin suodatin (esim. VST, MUU). Arvo NULL sisältää myös opetussuunnitelmat ilman JOTPA-tyyppiä. Useita arvoja voi antaa toistamalla parametrin. Tyhjä lista ei rajaa tuloksia.","in":"query","name":"jotpatyyppi","schema":{"items":{"type":"string"},"type":"array"}},{"description":"Suodattaa paikallisen tutkinnon osan (tosa.tyyppi = oma) perusteella. true = sisältää, false = ei sisällä, pois jätettynä suodatinta ei käytetä.","in":"query","name":"paikallistasisaltoa","schema":{"type":"boolean"}}],"responses":{"200":{"content":{"application/json;charset=UTF-8":{"schema":{"$ref":"#/components/schemas/SivutettuTulosDtoOpetussuunnitelmaDto"}}},"description":"OK"}},"tags":["external"]}},"/api/external/opintokokonaisuus/{koodiArvo}":{"get":{"operationId":"getPublicOpintokokonaisuusKoodilla","parameters":[{"in":"path","name":"koodiArvo","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json;charset=UTF-8":{"schema":{"$ref":"#/components/schemas/SisaltoviiteOpintokokonaisuusExternalDto"}}},"description":"OK"}},"summary":"Opintokokonaisuuden haku opintokokonaisuuden koodin arvolla","tags":["external"]}}},"servers":[{"description":"Generated server url","url":"https://virkailija.opintopolku.fi/eperusteet-amosaa-service"}]}